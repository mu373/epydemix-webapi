{
  "framework": "docusaurus-2",
  "installCommand": "bun install",
  "redirects": [
    { "source": "/", "destination": "/docs", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/.well-known/api-catalog",
      "destination": "/.well-known/api-catalog.json"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/api-catalog",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/linkset+json"
        }
      ]
    },
    {
      "source": "/(docs.*)?",
      "headers": [
        {
          "key": "Link",
          "value": "</.well-known/api-catalog>; rel=\"api-catalog\"; type=\"application/linkset+json\", </openapi.json>; rel=\"service-desc\"; type=\"application/json\", <https://epyscenario-api.isi.it/api/v1/health>; rel=\"status\"; type=\"application/json\""
        }
      ]
    }
  ]
}
