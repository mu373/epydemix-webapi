{
  "openapi": "3.1.0",
  "info": {
    "title": "epydemix WebAPI",
    "description": "REST API for running epidemic simulations with epydemix",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/simulations": {
      "post": {
        "tags": [
          "Simulations"
        ],
        "summary": "Run epidemic simulation",
        "description": "Execute an epidemic simulation with the specified configuration.",
        "operationId": "create_simulation_api_v1_simulations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SimulationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SimulationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/populations": {
      "get": {
        "tags": [
          "Populations"
        ],
        "summary": "List available populations",
        "description": "Get a list of all available populations that can be used in simulations.",
        "operationId": "get_populations_api_v1_populations_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PopulationListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/populations/cache": {
      "get": {
        "tags": [
          "Populations"
        ],
        "summary": "Get population cache status",
        "description": "Get information about the population cache.",
        "operationId": "get_cache_status_api_v1_populations_cache_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CacheInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/populations/{name}": {
      "get": {
        "tags": [
          "Populations"
        ],
        "summary": "Get population details",
        "description": "Get detailed information about a specific population.",
        "operationId": "get_population_api_v1_populations__name__get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "contacts_source",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Contact matrix source (prem_2017, prem_2021, or mistry_2021)",
              "title": "Contacts Source"
            },
            "description": "Contact matrix source (prem_2017, prem_2021, or mistry_2021)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PopulationDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/populations/{name}/contacts": {
      "get": {
        "tags": [
          "Populations"
        ],
        "summary": "Get contact matrices",
        "description": "Get contact matrices for a specific population.",
        "operationId": "get_contact_matrices_api_v1_populations__name__contacts_get",
        "parameters": [
          {
            "name": "name",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Name"
            }
          },
          {
            "name": "contacts_source",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Contact matrix source (prem_2017, prem_2021, or mistry_2021)",
              "title": "Contacts Source"
            },
            "description": "Contact matrix source (prem_2017, prem_2021, or mistry_2021)"
          },
          {
            "name": "layers",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "description": "Contact layers to include (e.g., home, work, school, community)",
              "title": "Layers"
            },
            "description": "Contact layers to include (e.g., home, work, school, community)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ContactMatrixResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models/presets": {
      "get": {
        "tags": [
          "Model Presets"
        ],
        "summary": "List model presets",
        "description": "Get information about available predefined epidemic models.",
        "operationId": "get_presets_api_v1_models_presets_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PresetsListResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Health Check",
        "description": "Check API health status.\n\nReturns the API version and epydemix library version to verify\nthe service is running correctly.\n\nReturns\n-------\nHealthResponse\n    Health status including API and epydemix versions.",
        "operationId": "health_check_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AgeGroupInfo": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Age group name (e.g., '0-4', '5-9')"
          },
          "population": {
            "type": "integer",
            "title": "Population",
            "description": "Population count in this age group"
          }
        },
        "type": "object",
        "required": [
          "name",
          "population"
        ],
        "title": "AgeGroupInfo",
        "description": "Information about a single age group.\n\nAttributes\n----------\nname : str\n    Age group name (e.g., '0-4', '5-9').\npopulation : int\n    Population count in this age group."
      },
      "CacheInfoResponse": {
        "properties": {
          "hits": {
            "type": "integer",
            "title": "Hits"
          },
          "misses": {
            "type": "integer",
            "title": "Misses"
          },
          "maxsize": {
            "type": "integer",
            "title": "Maxsize"
          },
          "currsize": {
            "type": "integer",
            "title": "Currsize"
          },
          "cached_populations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cached Populations"
          }
        },
        "type": "object",
        "required": [
          "hits",
          "misses",
          "maxsize",
          "currsize",
          "cached_populations"
        ],
        "title": "CacheInfoResponse",
        "description": "Cache information response schema.\n\nAttributes\n----------\nhits : int\n    Number of cache hits.\nmisses : int\n    Number of cache misses.\nmaxsize : int\n    Maximum cache size.\ncurrsize : int\n    Current number of cached items.\ncached_populations : list of str\n    Names of populations currently in cache."
      },
      "CompartmentResults": {
        "properties": {
          "dates": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Dates",
            "description": "Dates corresponding to values."
          },
          "data": {
            "additionalProperties": {
              "additionalProperties": {
                "additionalProperties": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              "type": "object"
            },
            "type": "object",
            "title": "Data",
            "description": "Nested structure:\n\n```\ncompartment -> age_group -> quantile -> [values]\n```"
          }
        },
        "type": "object",
        "required": [
          "dates",
          "data"
        ],
        "title": "CompartmentResults",
        "description": "Compartment trajectory quantiles."
      },
      "ContactMatrixResponse": {
        "properties": {
          "population_name": {
            "type": "string",
            "title": "Population Name"
          },
          "contact_source": {
            "type": "string",
            "title": "Contact Source"
          },
          "layers": {
            "additionalProperties": {
              "items": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "array"
            },
            "type": "object",
            "title": "Layers",
            "description": "Contact matrices by layer name"
          },
          "overall": {
            "anyOf": [
              {
                "items": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Overall",
            "description": "Combined contact matrix across all layers"
          },
          "age_groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Age Groups",
            "description": "Age group labels for matrix indices"
          },
          "spectral_radius": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Spectral Radius",
            "description": "Spectral radius (largest eigenvalue) for each layer and overall"
          }
        },
        "type": "object",
        "required": [
          "population_name",
          "contact_source",
          "layers",
          "age_groups"
        ],
        "title": "ContactMatrixResponse",
        "description": "Response containing contact matrices for a population.\n\nAttributes\n----------\npopulation_name : str\n    Population identifier.\ncontact_source : str\n    Contact matrix source used.\nlayers : dict of {str: list of list of float}\n    Contact matrices by layer name, each as a 2D list.\noverall : list of list of float or None\n    Combined contact matrix across all layers.\nage_groups : list of str\n    Age group labels corresponding to matrix indices.\nspectral_radius : dict of {str: float}\n    Spectral radius (largest eigenvalue) for each layer and overall matrix.\n    The spectral radius is related to the basic reproduction number (R0)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "epydemix_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Epydemix Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Health check response schema.\n\nAttributes\n----------\nstatus : str\n    Health status (e.g., 'healthy').\nversion : str\n    API version string.\nepydemix_version : str or None\n    Version of the epydemix library, or None if not available."
      },
      "InitialConditionsConfig": {
        "properties": {
          "method": {
            "type": "string",
            "enum": [
              "percentage",
              "absolute"
            ],
            "title": "Method",
            "description": "Method: `percentage` or `absolute`.",
            "default": "percentage"
          },
          "initial_percentages": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "number"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Initial Percentages",
            "description": "Percentage of population in each compartment. Remainder goes to the first compartment.\n\nExample:\n```json\n{\"I\": 0.01, \"R\": 10.0}\n```"
          },
          "compartments": {
            "anyOf": [
              {
                "additionalProperties": {
                  "items": {
                    "type": "number"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compartments",
            "description": "Absolute counts per compartment per age group. Required when method is `absolute`."
          }
        },
        "type": "object",
        "title": "InitialConditionsConfig",
        "description": "Initial conditions for compartments."
      },
      "InterventionConfig": {
        "properties": {
          "layer_name": {
            "type": "string",
            "title": "Layer Name",
            "description": "Contact layer to modify, e.g. `school`, `work`."
          },
          "start_date": {
            "type": "string",
            "title": "Start Date",
            "description": "Start date in `YYYY-MM-DD` format."
          },
          "end_date": {
            "type": "string",
            "title": "End Date",
            "description": "End date in `YYYY-MM-DD` format."
          },
          "reduction_factor": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Reduction Factor",
            "description": "Multiplier for contacts. `0.2` = reduce to 20% of normal."
          },
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name",
            "description": "Optional name for this intervention."
          }
        },
        "type": "object",
        "required": [
          "layer_name",
          "start_date",
          "end_date",
          "reduction_factor"
        ],
        "title": "InterventionConfig",
        "description": "A contact reduction intervention applied to a specific layer during a time period."
      },
      "ModelConfig": {
        "properties": {
          "preset": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "SIR",
                  "SEIR",
                  "SIS"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Preset",
            "description": "Predefined model preset (`SIR`, `SEIR`, `SIS`). Auto-configures compartments and transitions."
          },
          "compartments": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compartments",
            "description": "Compartment names. Required if no preset."
          },
          "parameters": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Parameters",
            "description": "Model parameters as key-value pairs.\n\nExample:\n```json\n{\"transmission_rate\": 0.3, \"recovery_rate\": 0.1}\n```"
          },
          "transitions": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/TransitionConfig"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transitions",
            "description": "Transition definitions. Required if no preset."
          }
        },
        "type": "object",
        "title": "ModelConfig",
        "description": "Epidemic model configuration.\n\nSpecify `preset` for a built-in model, or provide both `compartments` and `transitions` for a custom model."
      },
      "OutputConfig": {
        "properties": {
          "quantiles": {
            "anyOf": [
              {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantiles",
            "description": "Quantiles to compute. Default: `[0.025, 0.05, 0.25, 0.5, 0.75, 0.95, 0.975]`."
          },
          "include_trajectories": {
            "type": "boolean",
            "title": "Include Trajectories",
            "description": "Include raw trajectory data (can be large).",
            "default": false
          },
          "compartments": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Compartments",
            "description": "Compartments to include in output. Default: all."
          },
          "transitions": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Transitions",
            "description": "Transitions to include in output. Default: all."
          },
          "age_groups": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Groups",
            "description": "Age groups to include, e.g. `[\"0-4\", \"5-19\", \"total\"]`. Default: all."
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SummaryConfig"
              },
              {
                "type": "null"
              }
            ],
            "description": "Summary statistics configuration."
          }
        },
        "type": "object",
        "title": "OutputConfig",
        "description": "Output configuration."
      },
      "ParameterOverrideConfig": {
        "properties": {
          "parameter_name": {
            "type": "string",
            "title": "Parameter Name",
            "description": "Parameter to override."
          },
          "start_date": {
            "type": "string",
            "title": "Start Date",
            "description": "Start date in `YYYY-MM-DD` format."
          },
          "end_date": {
            "type": "string",
            "title": "End Date",
            "description": "End date in `YYYY-MM-DD` format."
          },
          "value": {
            "type": "number",
            "title": "Value",
            "description": "Parameter value during this period."
          }
        },
        "type": "object",
        "required": [
          "parameter_name",
          "start_date",
          "end_date",
          "value"
        ],
        "title": "ParameterOverrideConfig",
        "description": "Override a model parameter during a time period."
      },
      "PeakStatistic": {
        "properties": {
          "median": {
            "type": "number",
            "title": "Median"
          },
          "ci_95": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "title": "Ci 95"
          },
          "peak_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Peak Date"
          }
        },
        "type": "object",
        "required": [
          "median",
          "ci_95"
        ],
        "title": "PeakStatistic",
        "description": "Peak statistic with date."
      },
      "PopulationConfig": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Population name, e.g. `United_States`."
          },
          "contacts_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Contacts Source",
            "description": "Contact matrix source.\n\nOptions: `prem_2017`, `prem_2021`, `mistry_2021`."
          },
          "layers": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Layers",
            "description": "Contact layers to include.\n\nOptions: `home`, `work`, `school`, `community`."
          },
          "age_group_mapping": {
            "anyOf": [
              {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Age Group Mapping",
            "description": "Custom age group aggregation.\n\nKeys are new group names, values are lists of source age groups to merge.\n\nExample:\n```json\n{\n  \"0-19\": [\"0-4\", \"5-9\", \"10-14\", \"15-19\"],\n  \"20-64\": [\"20-24\", \"25-29\", ...],\n  \"65+\": [\"65-69\", \"70-74\", \"75+\"]\n}\n```"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "PopulationConfig",
        "description": "Population configuration."
      },
      "PopulationDetail": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          },
          "total_population": {
            "type": "integer",
            "title": "Total Population"
          },
          "age_groups": {
            "items": {
              "$ref": "#/components/schemas/AgeGroupInfo"
            },
            "type": "array",
            "title": "Age Groups"
          },
          "contact_sources": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Contact Sources"
          },
          "default_contact_source": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Default Contact Source"
          },
          "available_layers": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Available Layers"
          }
        },
        "type": "object",
        "required": [
          "name",
          "display_name",
          "total_population",
          "age_groups",
          "contact_sources",
          "available_layers"
        ],
        "title": "PopulationDetail",
        "description": "Detailed information about a population.\n\nAttributes\n----------\nname : str\n    Population identifier.\ndisplay_name : str\n    Human-readable name.\ntotal_population : int\n    Total population size.\nage_groups : list of AgeGroupInfo\n    Information about each age group.\ncontact_sources : list of str\n    Available contact matrix sources.\ndefault_contact_source : str or None\n    Default contact source for this population.\navailable_layers : list of str\n    Available contact layers (e.g., home, work, school, community)."
      },
      "PopulationListResponse": {
        "properties": {
          "populations": {
            "items": {
              "$ref": "#/components/schemas/PopulationSummary"
            },
            "type": "array",
            "title": "Populations"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "populations",
          "total"
        ],
        "title": "PopulationListResponse",
